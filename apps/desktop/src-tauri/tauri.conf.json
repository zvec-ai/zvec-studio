{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zvec Studio",
  "version": "0.1.0",
  "identifier": "studio.zvec.app",
  "build": {
    "beforeDevCommand": "pnpm --filter frontend dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm --filter frontend build",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zvec Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "externalBin": ["binaries/zvec-studio-sidecar"],
    "category": "DeveloperTool",
    "shortDescription": "Visual management for Zvec vector database",
    "longDescription": "Zvec Studio is a desktop application for managing local Zvec collections, browsing documents and running vector searches against an embedded Python sidecar."
  }
}
